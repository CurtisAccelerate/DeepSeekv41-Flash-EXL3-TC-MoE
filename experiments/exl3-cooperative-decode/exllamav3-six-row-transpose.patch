+// EXL transposed operand control: original decoded f0/f1 become A=W^T.
+// No trellis/decoder change; B holds the same two activation half2 pairs.
+__device__ __forceinline__ void mma_transposed_h(const FragB& f0, const FragB& f1,
+    half2 x0, half2 x1, FragC_h& c)
+{
+    const uint32_t* w0=reinterpret_cast<const uint32_t*>(&f0);
+    const uint32_t* w1=reinterpret_cast<const uint32_t*>(&f1);
+    const uint32_t a=*reinterpret_cast<const uint32_t*>(&x0);
+    const uint32_t b=*reinterpret_cast<const uint32_t*>(&x1);
+    uint32_t* cc=reinterpret_cast<uint32_t*>(&c);
+    asm volatile("mma.sync.aligned.m16n8k16.row.col.f16.f16.f16.f16 "
+        "{%0,%1}, {%2,%3,%4,%5}, {%6,%7}, {%0,%1};"
+        : "+r"(cc[0]), "+r"(cc[1])
+        : "r"(w0[0]), "r"(w1[0]), "r"(w0[1]), "r"(w1[1]), "r"(a), "r"(b));
+}
